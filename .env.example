# ---- Main database: MySQL (set DB_BACKEND=sqlite to run with zero setup) ----
DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DB=roleready

# ---- Optional: MongoDB stores resume-analysis documents ----
# Leave blank to store them in a MySQL table instead.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=roleready

SECRET_KEY=change-me
